[Desktop Entry]
Type=Application
Name=OtterBench
Comment=Control, log and automate bench instruments (GPIB supplies and meters, PPK2, logic analyzers, generators, GPIO)
# Assumes the repository was cloned to ~/ee-workbench. If it lives elsewhere,
# change the path below (or run scripts/setup-pi.sh, which fills it in).
# Drop --fullscreen to start in a normal window. Add --restart-on-crash
# (before --fullscreen) to start it again if it ever crashes (kiosk use).
Exec=sh -c "exec ~/ee-workbench/run.sh --fullscreen"
Icon=ee-workbench
StartupWMClass=ee-workbench
Terminal=false
Categories=Electronics;Science;
